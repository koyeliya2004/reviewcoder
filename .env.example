# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Key for Groq LPU inference
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# AI_PROXY_RATE_LIMIT_MAX: Requests allowed per window (optional, default 60)
AI_PROXY_RATE_LIMIT_MAX=60

# AI_PROXY_RATE_LIMIT_WINDOW_MS: Window size in ms (optional, default 60000)
AI_PROXY_RATE_LIMIT_WINDOW_MS=60000

# OPENROUTER_API_KEY: Key for OpenRouter models
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
